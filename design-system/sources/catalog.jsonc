    "document.saved.failure.read": {"text": "The saved capture could not be opened or verified. Try opening it again, or explicitly delete it. It has not been replaced.", "context": "Local saved optical capture in the iOS SDK app; restoration is historical evidence, not document or identity verification.", "arguments": {}},
    "document.saved.failure.delete": {"text": "Deletion did not finish. Retry deleting the saved capture. Do not assume it has been removed.", "context": "Local saved optical capture in the iOS SDK app; restoration is historical evidence, not document or identity verification.", "arguments": {}},

  "messages": {
    "document.back.instruction": {"text": "Turn the card over and place its PDF417 barcode inside the guide. Hold still for automatic capture.", "context": "Live back-side PDF417 acquisition in the iOS SDK reference app; optical decoding is not issuing-state verification.", "arguments": {}},
    "document.front.instruction": {"text": "Place the front of your licence or state ID in the guide. Capture is automatic when the image is ready.", "context": "Shared native front capture guidance; level is advisory and optical capture is not identity verification.", "arguments": {}},

            "variants": {
              "const": [
                "primary",
                "secondary"
              ]
            },
            "states": {
              "const": [
                "enabled",
                "disabled",
                "focused"
              ]
            },
            "foreground": {
              "type": "string",
              "enum": [
                "background",
                "surface",
                "primary",
                "text",
                "secondary",
                "border",
                "onPrimary",
                "error"
              ]
            },
            "background": {
              "type": "string",
              "enum": [
                "background",
                "surface",
                "primary",
                "text",
                "secondary",
                "border",
                "onPrimary",
                "error"
              ]

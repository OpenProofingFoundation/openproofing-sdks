    "colors": {
      "$ref": "#/$defs/palette"
    },
    "darkColors": {
      "$ref": "#/$defs/palette"
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "enum": [
            "background",
            "surface",
            "primary",
            "text",
            "secondary",
            "border",
            "onPrimary",
            "error"
          ]
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128

  "required": [
    "schemaVersion",
    "version",
    "colors",
    "darkColors",
    "contrastPairs",
    "spacing",
    "dimensions",
    "shape",
    "borders",
    "elevation",
    "motion",
    "typography",
    "icons",
    "components",
    "platforms",
    "platformPrimitives"

  "additionalProperties": false,
  "$defs": {
    "palette": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "onPrimary": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        }

        "gap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "compact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "page",
        "gap",
        "compact"

        "minimumTargetIOS",
        "minimumTargetAndroid",
        "contentMax",
        "selfieGuideWidthPercent",
        "selfieGuideHeightPercent",
        "passportMediaHeight",
        "documentLevelDiameter",
        "documentLevelTravel",
        "documentLevelInnerDiameter",
        "documentLevelBubbleDiameter",
        "documentLevelCrosshairLength",
        "documentStatusMinimumHeight",
        "documentPreviewWidth",

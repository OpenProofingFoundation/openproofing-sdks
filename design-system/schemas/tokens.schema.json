            "foreground": {
              "type": "string",
              "enum": [
                "background",
                "surface",
                "primary",
                "text",
                "secondary",
                "border",
                "onPrimary",
                "error"
              ]
            },
            "background": {
              "type": "string",
              "enum": [
                "background",
                "surface",
                "primary",
                "text",
                "secondary",
                "border",
                "onPrimary",
                "error"
              ]
            }
          },
          "required": [
            "role",
            "slots",
            "variants",
            "states",
            "foreground",
            "background"
          ],
          "additionalProperties": false
        }

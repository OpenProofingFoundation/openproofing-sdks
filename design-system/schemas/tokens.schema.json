        "documentLevelDiameter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "documentLevelTravel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "documentLevelInnerDiameter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "documentLevelBubbleDiameter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "documentLevelCrosshairLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128

            "android": {
              "type": "string",
              "enum": [
                "headlineMedium",
                "bodyLarge",
                "labelLarge"
              ]
            },
            "scales": {
              "const": true
            },
            "sizeSP": {
              "type": "integer",
              "minimum": 12,
              "maximum": 48
            }
          },
          "required": [
            "ios",
            "android",
            "scales",
            "sizeSP"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "ios": {
              "type": "string",
              "enum": [
                "UICTFontTextStyleTitle1",
                "UICTFontTextStyleBody",
                "UICTFontTextStyleHeadline"
              ]
            },
            "android": {
              "type": "string",
              "enum": [
                "headlineMedium",
                "bodyLarge",
                "labelLarge"
              ]
            },
            "scales": {
              "const": true
            },
            "sizeSP": {
              "type": "integer",
              "minimum": 12,
              "maximum": 48
            }
          },
          "required": [
            "ios",
            "android",
            "scales",
            "sizeSP"
          ],
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "properties": {
            "ios": {
              "type": "string",
              "enum": [
                "UICTFontTextStyleTitle1",
                "UICTFontTextStyleBody",
                "UICTFontTextStyleHeadline"
              ]
            },
            "android": {
              "type": "string",
              "enum": [
                "headlineMedium",
                "bodyLarge",
                "labelLarge"
              ]
            },
            "scales": {
              "const": true
            },
            "sizeSP": {
              "type": "integer",
              "minimum": 12,
              "maximum": 48
            }
          },
          "required": [
            "ios",
            "android",
            "scales",
            "sizeSP"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "body",
        "action"
      ],
      "additionalProperties": false

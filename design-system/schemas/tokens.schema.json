            "material": {
              "type": "object",
              "properties": {
                "introducedIOS": {
                  "const": 26
                },
                "scope": {
                  "const": "controlsAndNavigation"
                },
                "fallback": {
                  "const": "nativeSystemAppearance"
                },
                "reduceTransparency": {
                  "const": "systemManaged"
                }
              },
              "required": [
                "introducedIOS",
                "scope",
                "fallback",
                "reduceTransparency"

    {"id": "acceleration_in_g", "kind": "descriptor", "quantity": "acceleration", "unit": "standardGravity", "gravity": "excluded", "accepted": true},
    {"id": "unit_substitution", "kind": "descriptor", "quantity": "acceleration", "unit": "radiansPerSecond", "gravity": "excluded", "accepted": false},

    {
      "id": "fp32-largest-finite",
      "operation": "normalize",
      "leftFeatures": [
        3.4028234663852886e+38,
        0
      ],
      "expect": {
        "norm": 3.4028234663852886e+38,
        "components": [
          1,
          0
        ]
      }
    },
    {
      "id": "fp32-extreme-scale-invariance",
      "operation": "compare",
      "leftFeatures": [
        1.401298464324817e-45,
        0
      ],
      "rightFeatures": [
        3.4028234663852886e+38,
        0
      ],
      "spaceOverrides": {
        "minimumNorm": 7.006492321624085e-46
      },
      "expect": {
        "cosine": 1,
        "angularDistanceRadians": 0
      }
    }

{
  "schemaVersion": 1,
  "contract": "kenshiki.embedding-math/1",
  "absoluteTolerance": 1e-12,
  "normRelativeTolerance": 1e-12,
  "baseSpace": {
    "artifactManifestSHA256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "domain": "face_identity",
    "dimensions": 2,
    "minimumNorm": 0.01
  },
  "vectors": [
    {
      "id": "known-three-four",
      "operation": "normalize",
      "leftFeatures": [
        3,
        4
      ],
      "expect": {
        "norm": 5,
        "components": [
          0.6,
          0.8
        ]
      }
    },
    {
      "id": "negative-components",
      "operation": "normalize",
      "leftFeatures": [
        -3,
        -4
      ],
      "expect": {
        "norm": 5,
        "components": [
          -0.6,
          -0.8
        ]
      }
    },
    {
      "id": "exact-floor",
      "operation": "normalize",
      "leftFeatures": [
        3,
        4
      ],
      "spaceOverrides": {
        "minimumNorm": 5
      },
      "expect": {
        "norm": 5,
        "components": [
          0.6,
          0.8
        ]
      }
    },
    {
      "id": "below-floor",
      "operation": "normalize",
      "leftFeatures": [
        3,
        4
      ],
      "spaceOverrides": {
        "minimumNorm": 5.000000000000001
      },
      "expect": {
        "failure": "invalid_norm"
      }
    },
    {
      "id": "zero-vector",
      "operation": "normalize",
      "leftFeatures": [
        0,
        0
      ],
      "expect": {
        "failure": "invalid_norm"
      }
    },
    {
      "id": "dimension-missing",
      "operation": "normalize",
      "leftFeatures": [],
      "expect": {
        "failure": "dimension_mismatch"
      }
    },
    {
      "id": "dimension-short",
      "operation": "normalize",
      "leftFeatures": [
        1
      ],
      "expect": {
        "failure": "dimension_mismatch"
      }
    },
    {
      "id": "dimension-long",
      "operation": "normalize",
      "leftFeatures": [
        1,
        2,
        3
      ],
      "expect": {
        "failure": "dimension_mismatch"
      }
    },
    {
      "id": "feature-nan",
      "operation": "normalize",
      "leftFeatures": [
        "nan",
        1
      ],
      "expect": {
        "failure": "nonfinite_feature"
      }
    },
    {
      "id": "feature-positive_infinity",
      "operation": "normalize",
      "leftFeatures": [
        "positive_infinity",
        1

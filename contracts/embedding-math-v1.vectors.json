      "leftFeatures": [
        3,
        4
      ],
      "spaceOverrides": {
        "artifactManifestSHA256": "gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg"
      },
      "expect": {
        "failure": "invalid_digest"
      }
    },
    {
      "id": "parallel",

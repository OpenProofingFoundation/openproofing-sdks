    {
      "id": "incompatible-minimumNorm",
      "operation": "compare",
      "leftFeatures": [
        3,
        4
      ],
      "rightFeatures": [
        3,
        4
      ],
      "rightSpaceOverrides": {
        "minimumNorm": 0.02
      },
      "expect": {
        "failure": "incompatible_space"
      }
    },
    {
      "id": "incompatible-dimension",
      "operation": "compare",
      "leftFeatures": [
        3,
        4
      ],
      "rightFeatures": [
        1
      ],
      "rightSpaceOverrides": {
        "dimensions": 1
      },
      "expect": {
        "failure": "incompatible_space"

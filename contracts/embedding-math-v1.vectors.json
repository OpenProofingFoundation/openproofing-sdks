      "expect": {
        "failure": "nonfinite_feature"
      }
    },
    {
      "id": "feature-negative_infinity",
      "operation": "normalize",
      "leftFeatures": [
        "negative_infinity",
        1
      ],
      "expect": {
        "failure": "nonfinite_feature"
      }
    },
    {
      "id": "shape-before-nonfinite",
      "operation": "normalize",
      "leftFeatures": [
        "nan"
      ],
      "expect": {
        "failure": "dimension_mismatch"
      }
    },
    {
      "id": "floor-zero",
      "operation": "normalize",
      "leftFeatures": [
        3,
        4
